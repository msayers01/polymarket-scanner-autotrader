# Copy to .env and fill in. Never commit .env.

# --- Live trading (only needed for mode: live) ---
PMT_SECRETS__POLYMARKET_PRIVATE_KEY=
PMT_SECRETS__POLYMARKET_WALLET=
PMT_SECRETS__POLYMARKET_RELAYER_API_KEY=
PMT_SECRETS__POLYMARKET_RELAYER_API_KEY_ADDRESS=
# Must equal I_ACCEPT_RISK for live mode to start at all
PMT_LIVE_CONFIRM=

# --- Discord bot ---
PMT_SECRETS__DISCORD_TOKEN=
# PMT_DISCORD__ENABLED=true
# PMT_DISCORD__CHANNEL_ID=123456789012345678
# PMT_DISCORD__GUILD_ID=123456789012345678
# PMT_DISCORD__OWNER_USER_IDS=[123456789012345678]

# --- Web UI auth (recommended if you bind to anything but 127.0.0.1) ---
PMT_SECRETS__WEB_TOKEN=

# --- LLM providers (referenced by llm.providers[].api_key_env) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
